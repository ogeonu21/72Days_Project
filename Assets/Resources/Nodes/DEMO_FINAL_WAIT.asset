  nodeMessage: "\uD559\uAD50 \uBCF5\uB3C4 \uB05D\uC5D0\uC11C \uD734\uB300\uC804\uD654\uAC00
    \uC7A0\uAE50 \uAE30\uC9C0\uAD6D\uC744 \uC7A1\uC558\uB2E4. \uAE40\uD558\uC11D
    \uC911\uC0AC\uC5D0\uAC8C \uBCF4\uB0B8 \uBB38\uC790\uB294 \uC804\uC1A1\uB410\uC9C0\uB9CC
    \uB2F5\uC740 \uC5C6\uC5C8\uB2E4. \uD61C\uC778\uC5D0\uAC8C \uBCF4\uB0B8 \uBB38\uC790
    \uC606\uC5D0\uB294 \uC5EC\uC804\uD788 \uC804\uC1A1 \uC911 \uD45C\uC2DC\uAC00
    \uB0A8\uC558\uB2E4. \uBD81\uCABD \uC9D1\uACB0\uC9C0\uC640 \uC11C\uCABD \uB3D9\uB124\uB294
    \uC544\uC9C1 \uC9C0\uB3C4 \uC704\uC758 \uB450 \uBC29\uD5A5\uC77C \uBFD0\uC774\uC5C8\uB2E4.\n\uB300\uD53C\uC18C
